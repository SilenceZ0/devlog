---
import { Image } from 'astro:assets';
import { render } from 'astro:content';

import Gallery from '../components/Gallery.astro';
import EstadoBadge from '../components/EstadoBadge.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import Base from './Base.astro';
import { CATEGORIA_INFO, SITIO } from '../site.config';
import { formatearFecha, slugificar, type Entrada } from '../utils/posts';
import { url } from '../utils/url';

interface Props {
	entrada: Entrada;
}

const { entrada } = Astro.props;
const { data } = entrada;
const { Content, headings } = await render(entrada);
const categoria = CATEGORIA_INFO[data.categoria];
---

<Base
	titulo={`${data.titulo} · ${SITIO.nombre}`}
	descripcion={data.resumen}
	imagen={data.portada?.src}
	tipo="article"
>
	<div class="contenedor contenedor--texto">
		<article>
			<header class="entrada__cabecera">
				<div class="entrada__meta">
					<a class="pildora pildora--acento" href={url(`/categorias/${data.categoria}/`)}>
						{categoria.etiqueta}
					</a>
					<EstadoBadge estado={data.estado} />
					<time datetime={data.fecha.toISOString()}>{formatearFecha(data.fecha)}</time>
					{
						data.actualizado && (
							<span>· actualizado el {formatearFecha(data.actualizado)}</span>
						)
					}
				</div>

				<h1 class="entrada__titulo">{data.titulo}</h1>
				<p class="entrada__resumen">{data.resumen}</p>
			</header>

			{
				data.portada && (
					<figure class="entrada__portada">
						<Image
							src={data.portada}
							alt={data.portadaAlt ?? ''}
							widths={[600, 1200]}
							sizes="(max-width: 46rem) 92vw, 720px"
							loading="eager"
							decoding="async"
						/>
					</figure>
				)
			}

			{data.video && <VideoEmbed id={data.video} titulo={data.videoTitulo} />}

			<div class="prosa">
				<Content components={{ VideoEmbed, Gallery }} />
			</div>

			{
				data.galeria.length > 0 && (
					<section class="seccion" aria-labelledby="titulo-galeria">
						<div class="seccion__cabecera">
							<h2 class="seccion__titulo" id="titulo-galeria">
								Galería
							</h2>
							<span class="etiqueta-seccion">
								{data.galeria.length}{' '}
								{data.galeria.length === 1 ? 'imagen' : 'imágenes'}
							</span>
						</div>
						<Gallery imagenes={data.galeria} />
					</section>
				)
			}

			<footer class="entrada__pie">
				<div class="entrada__tags">
					{
						data.tags.map((tag) => (
							<a class="pildora" href={url(`/tags/${slugificar(tag)}/`)}>
								#{tag}
							</a>
						))
					}
				</div>
				<a class="boton" href={url('/entradas/')}>← Volver a las entradas</a>
			</footer>
		</article>
	</div>
</Base>
