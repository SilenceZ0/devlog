---
import Base from '../layouts/Base.astro';
import { SITIO } from '../site.config';
import { url } from '../utils/url';
---

<Base titulo={`Página no encontrada · ${SITIO.nombre}`} descripcion="Esta página no existe.">
	<div class="contenedor contenedor--texto">
		<header class="cabecera-pagina">
			<p class="etiqueta-seccion">Error 404</p>
			<h1>Esta página no existe</h1>
			<p>
				Puede que el enlace esté mal escrito o que la entrada ya no esté disponible.
			</p>
		</header>

		<div class="hero__acciones">
			<a class="boton boton--principal" href={url('/')}>Volver al inicio</a>
			<a class="boton" href={url('/entradas/')}>Ver todas las entradas</a>
		</div>
	</div>
</Base>
